# App
NEXT_PUBLIC_APP_URL=https://orcachatone.vercel.app

# Redis (set when running via docker-compose, leave empty for in-memory fallback)
# REDIS_URL=

# OpenRouter API Keys (tried in order if one fails/rate-limited)
# All must be valid OpenRouter keys (sk-or-v1-...)
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=

# Optional: Rate Limiting
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW=

# Optional: Features
ENABLE_WEB_SEARCH=true
ENABLE_FILE_UPLOAD=true

# Optional: Encrypted audit log (metadata only – never message content).
# The log is AES-256-GCM encrypted at rest. Leave AUDIT_LOG_KEY unset to
# disable logging entirely (fail closed).
# AUDIT_LOG_KEY=
# AUDIT_LOG_DIR=